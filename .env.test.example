USER_ID=test-user-123
JWT=your-test-jwt-token
PUBLIC_API_KEY=your-public-api-key
TENANT_ID=your-test-tenant-id
MESSAGE_TRACKING_ID=your-test-message-tracking-id
MESSAGE_ID=your-test-message-id
BRAND_ID=your-test-branch-id
TOPIC_ID=your-test-topic-id
COURIER_REST_URL=https://api.courier.com
COURIER_GRAPHQL_URL=https://api.courier.com/client/q
INBOX_GRAPHQL_URL=https://inbox.courier.com/q
