{
  "name": "@trycourier/courier-ui-preferences",
  "version": "1.3.3",
  "description": "Notification preference center Web Components that work in any framework or none, from Courier.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ci": "yarn build && yarn generate-api-doc",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "jest",
    "generate-api-doc": "api-extractor run"
  },
  "keywords": [
    "courier",
    "ui",
    "preferences",
    "typescript",
    "browser",
    "web-components",
    "notification-preferences",
    "preference-center",
    "notifications"
  ],
  "author": "Courier",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/trycourier/courier-web"
  },
  "homepage": "https://www.courier.com/docs/in-app/add-a-preference-center",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@trycourier/courier-js": "3.7.1",
    "@trycourier/courier-ui-core": "2.5.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "6.2.6",
    "vite-plugin-dts": "4.5.3"
  }
}
