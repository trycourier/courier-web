{
  "name": "@trycourier/courier-vue",
  "version": "1.1.5",
  "description": "Drop-in notification inbox, toasts, and preference center for Vue 3. Real-time in-app notifications from Courier.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_ENV=production tsc && vite build --mode production",
    "build:ci": "yarn build && yarn generate-api-doc",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-api-doc": "api-extractor run"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "courier",
    "ui",
    "vue",
    "typescript",
    "browser",
    "vue-notifications",
    "notification-inbox",
    "notification-center",
    "in-app-notifications",
    "inbox",
    "toast"
  ],
  "author": "Courier",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/trycourier/courier-web"
  },
  "homepage": "https://www.courier.com/docs/sdk-libraries/courier-vue-web",
  "dependencies": {
    "@trycourier/courier-js": "3.7.1",
    "@trycourier/courier-ui-core": "2.5.2",
    "@trycourier/courier-ui-inbox": "2.7.4",
    "@trycourier/courier-ui-toast": "2.4.2",
    "@trycourier/courier-ui-preferences": "1.3.3"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^7.0.3",
    "cross-fetch": "^3.2.0",
    "dotenv": "^16.4.7",
    "jsdom": "^25.0.1",
    "vite": "6.2.6",
    "vite-plugin-dts": "4.5.3",
    "vitest": "^2.1.9",
    "vue": "^3.5.13"
  }
}
